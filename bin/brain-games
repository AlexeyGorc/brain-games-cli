#!/usr/bin/env php
<?php

declare(strict_types=1);

use BrainGames\Application;
use BrainGames\Game\GameRegistry;
use BrainGames\Io\ConsoleIo;

require __DIR__ . '/bootstrap.php';

$registry = GameRegistry::default();

if ($argc < 2) {
    echo 'Usage: brain-games <' . implode('|', $registry->ids()) . '>', PHP_EOL;
    exit(Application::EXIT_USAGE);
}

exit((new Application(new ConsoleIo(), $registry))->runGame($argv[1]));
