{
    "name": "zorc/brain-games-cli",
    "type": "project",
    "description": "Five brain-training mini games for the terminal",
    "keywords": ["cli", "game", "php"],
    "license": "MIT",
    "homepage": "https://github.com/AlexeyGorc/brain-games-cli",
    "authors": [
        {
            "name": "Alexey Goncharenko",
            "email": "zomorc@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "BrainGames\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrainGames\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/brain-games",
        "bin/brain-even",
        "bin/brain-calc",
        "bin/brain-gcd",
        "bin/brain-progression",
        "bin/brain-prime"
    ],
    "scripts": {
        "lint": "phpcs",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "wp-cli/php-cli-tools": "^v0.13.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.11",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0"
    }
}
