{
    "name": "zorc/brain-games-cli",
    "type": "project",
    "description": "Brain games in your CLI",
    "license": "MIT",
    "homepage": "https://github.com/AlexeyGorc/brain-games-cli",
    "bin": [
        "bin/brain-games",
        "bin/brain-even",
        "bin/brain-calc",
        "bin/brain-gcd",
        "bin/brain-progression",
        "bin/brain-prime"
    ],
    "autoload": {
        "files": [
            "src/Engine.php",
            "src/Cli.php",
            "src/Games/even.php",
            "src/Games/calc.php",
            "src/Games/gcd.php",
            "src/Games/progression.php",
            "src/Games/prime.php"
        ]
    },
    "authors": [
        {
            "name": "Alexey Goncharenko",
            "email": "zomorc@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "wp-cli/php-cli-tools": "^v0.13.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "*",
        "phpstan/phpstan": "^1.10"
    }
}
